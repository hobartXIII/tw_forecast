{
  "name": "Python 3 + Node.js",
  // 後端（Python）與前端（forecast/web，Vite + React）的開發環境。More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "forecast/README.md",
        "forecast/web/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r requirements-dev.txt && cd forecast/web && npm ci && echo '✅ Packages installed and Requirements met'",
  // 前端需要 forecast/web/.env.local（見 forecast/web/.env.example）才讀得到資料
  "postAttachCommand": {
    "server": "cd forecast/web && npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": {
      "label": "Dashboard (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    5173
  ]
}
